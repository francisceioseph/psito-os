+/**
+ * Flutter counts text offsets in UTF-16 code units, the model here counts
+ * symbols (code points). A 4-byte UTF-8 symbol (e.g. emoji) is 2 UTF-16 units.
+ * Negative offsets (no selection) are passed through.
+ */
+static int utf16_to_symbol_index(int utf16_index) {
+    uint8_t *cursor = (uint8_t *) text_input.text;
+    int units = 0, symbol_index = 0;
+
+    if (utf16_index < 0)
+        return utf16_index;
+
+    while (*cursor && units < utf16_index) {
+        uint8_t length = utf8_symbol_length(*cursor);
+        if (!length)
+            break;
+        units += length == 4 ? 2 : 1;
+        cursor += length;
+        symbol_index++;
+    }
+
+    return symbol_index;
+}
+
+static int symbol_to_utf16_index(int symbol_index) {
+    uint8_t *cursor = (uint8_t *) text_input.text;
+    int units = 0;
+
+    if (symbol_index < 0)
+        return symbol_index;
+
+    for (; symbol_index && *cursor; symbol_index--) {
+        uint8_t length = utf8_symbol_length(*cursor);
+        if (!length)
+            break;
+        units += length == 4 ? 2 : 1;
+        cursor += length;
+    }
+
+    return units;
+}
