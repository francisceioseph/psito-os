# O pacote psito-shell (tools/psito-deb --system shell): o shell, a sessão
# (o labwc com o shell), o sandbox dos apps e a configuração dos portais.
PACKAGE=psito-shell
DEST=/usr/lib/psito/shell
BINARY=psito_shell
DESCRIPTION="Shell do Psito OS (cliente layer-shell do labwc)"
# O terminal dos apps com Terminal=true, os ícones SVG e as pastas do usuário
DEPENDS="labwc, wlr-randr, bubblewrap, xdg-dbus-proxy, xdg-desktop-portal, xdg-desktop-portal-gtk, gsettings-desktop-schemas, dconf-gsettings-backend, librsvg2-common, foot, xdg-user-dirs"
FILES=(
    session/psito-session:/usr/bin/psito-session
    session/psito-shell-start:/usr/bin/psito-shell-start
    session/psito-sandbox:/usr/bin/psito-sandbox
    session/psito-shell.service:/usr/lib/systemd/user/psito-shell.service
    session/psito-portals.conf:/usr/share/xdg-desktop-portal/psito-portals.conf
    session/psito-mimeapps.list:/usr/share/applications/psito-mimeapps.list
    session/labwc:/usr/share/psito/labwc
)
