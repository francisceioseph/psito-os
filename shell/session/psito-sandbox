#!/bin/bash
# Abre um app do Psito no sandbox: o bubblewrap com as permissões do manifesto
# (o X-Psito-Permissions do .desktop) e o D-Bus filtrado por um xdg-dbus-proxy
# só dele. O shell chama dentro do systemd-run do app, então o proxy fica no
# mesmo escopo e morre junto.
#
#   psito-sandbox --app <app-id> [--permissions "a;b"] [--file <fora> <dentro>]...
#                 [--dry-run] -- <comando...>
#
# Permissões: network (a rede e ler o estado do NetworkManager; mudar, só junto
# com settings), settings (o Update do
# org.psito.Settings, o org.psito.Storage, o org.psito.Displays e mudar o fuso e o nome), files:home (o $HOME de verdade),
# files:removable (os discos externos: a /media e o org.psito.Volumes) e
# notifications (o org.freedesktop.Notifications). Sem files:home, o $HOME é
# ~/.local/share/psito/apps/<app-id>/. Cada --file dá ao app um arquivo (ou
# pasta) que ele não veria: o shell monta <fora> em <dentro>, que fica em
# $XDG_RUNTIME_DIR/doc/ (a ideia do portal de documentos do Flatpak) e é o
# caminho que o app recebe. O --dry-run imprime os comandos do
# proxy e do bwrap, um argumento por linha, e não roda nada.
#
# Com a acessibilidade ligada (org.a11y.Status), o app fala com o barramento dela
# por um proxy que só deixa ele se registrar, como no Flatpak: direto, ele leria
# a tela dos outros apps e mandaria teclas para eles. Desligada, nada disso abre
# ($PSITO_A11Y_BUS, para testar, é o endereço que o barramento responderia).
# Vai no pacote psito-shell, em /usr/bin.
set -e

APP=
PERMISSIONS=
DRY_RUN=0
FILES=()
while [ $# -gt 0 ]; do
    case "$1" in
        --app) APP="$2"; shift 2 ;;
        --permissions) PERMISSIONS="$2"; shift 2 ;;
        --file) FILES+=("$2" "$3"); shift 3 ;;
        --dry-run) DRY_RUN=1; shift ;;
        --) shift; break ;;
        *) echo "psito-sandbox: argumento desconhecido: $1" >&2; exit 2 ;;
    esac
done
if [ -z "$APP" ] || [ $# -eq 0 ]; then
    echo "uso: psito-sandbox --app <app-id> [--permissions \"a;b\"] -- <comando...>" >&2
    exit 2
fi
# O id vira um caminho: nada de / nem ..
if ! [[ "$APP" =~ ^[A-Za-z0-9._-]+$ ]] || [[ "$APP" == *..* ]]; then
    echo "psito-sandbox: id de app inválido: $APP" >&2
    exit 2
fi

has() { [[ ";$PERMISSIONS;" == *";$1;"* ]]; }

RUN="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
WAYLAND="${WAYLAND_DISPLAY:-wayland-0}"
SESSION_BUS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$RUN/bus}"
SYSTEM_BUS="${DBUS_SYSTEM_BUS_ADDRESS:-unix:path=/run/dbus/system_bus_socket}"
SOCKETS="$RUN/psito-sandbox/$APP-$$"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/psito/apps/$APP"

# Os arquivos dados: o de fora existe, e o de dentro fica em $RUN/doc/
DOCS=()
for ((i = 0; i < ${#FILES[@]}; i += 2)); do
    outside="${FILES[i]}" inside="${FILES[i + 1]}"
    if [[ "$inside" != "$RUN/doc/"* ]] || [[ "/$inside/" == */../* ]]; then
        echo "psito-sandbox: caminho de dentro inválido: $inside" >&2
        exit 2
    fi
    if [ ! -e "$outside" ]; then
        echo "psito-sandbox: não existe: $outside" >&2
        exit 2
    fi
    DOCS+=(--bind "$outside" "$inside")
done

SETTINGS=(org.psito.Settings org.psito.Settings /org/psito/Settings)
LAUNCHER=(org.psito.Launcher org.psito.Launcher /org/psito/Launcher)
proxy=(xdg-dbus-proxy
    "$SESSION_BUS" "$SOCKETS/bus" --filter
    --talk=org.freedesktop.portal.Desktop
    --talk=org.freedesktop.portal.Documents
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.Open@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.OpenWith@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.AppsFor@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.NextOpen@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.OfferDrag@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.AcceptsDrop@${LAUNCHER[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.OpenDropped@${LAUNCHER[2]}"
    "--call=${SETTINGS[0]}=${SETTINGS[1]}.Get@${SETTINGS[2]}"
    "--broadcast=${SETTINGS[0]}=${SETTINGS[1]}.Changed@${SETTINGS[2]}"
)
has settings && proxy+=("--call=${SETTINGS[0]}=${SETTINGS[1]}.Update@${SETTINGS[2]}"
    "--call=${LAUNCHER[0]}=${LAUNCHER[1]}.ImportVpn@${LAUNCHER[2]}")
# O padrão de cada tipo é do usuário: só quem vê os arquivos dele
has files:home && proxy+=("--call=${LAUNCHER[0]}=${LAUNCHER[1]}.SetDefault@${LAUNCHER[2]}")
has notifications && proxy+=(--talk=org.freedesktop.Notifications)
has files:removable && proxy+=(--talk=org.psito.Volumes)
has settings && proxy+=(--talk=org.psito.Storage --talk=org.psito.Displays)

# O sistema: ler o nome e a hora é de todos (o systemInfo e o time do
# contexto); mudar o fuso, o NTP e o nome só com settings
proxy+=("$SYSTEM_BUS" "$SOCKETS/system_bus" --filter)
for service in hostname1 timedate1; do
    name=org.freedesktop.$service
    if has settings; then
        proxy+=("--talk=$name")
    else
        proxy+=("--call=$name=org.freedesktop.DBus.Properties.*@/org/freedesktop/$service"
            "--broadcast=$name=org.freedesktop.DBus.Properties.PropertiesChanged@/org/freedesktop/$service")
    fi
done
has settings || proxy+=("--call=org.freedesktop.timedate1=org.freedesktop.timedate1.ListTimezones@/org/freedesktop/timedate1")
has settings && proxy+=(--talk=org.freedesktop.Accounts)
# As conexões guardadas têm as senhas de Wi-Fi, e o NetworkManager entrega ao dono
# da conta. Por isso, só quem muda o sistema fala com ele; o resto só lê o estado.
if has network; then
    if has settings; then
        proxy+=(--talk=org.freedesktop.NetworkManager)
    else
        proxy+=("--call=org.freedesktop.NetworkManager=org.freedesktop.DBus.ObjectManager.GetManagedObjects@/org/freedesktop"
            "--call=org.freedesktop.NetworkManager=org.freedesktop.DBus.Properties.Get@/org/freedesktop/*"
            "--call=org.freedesktop.NetworkManager=org.freedesktop.DBus.Properties.GetAll@/org/freedesktop/*"
            "--broadcast=org.freedesktop.NetworkManager=*@/org/freedesktop/*")
    fi
fi

# Sem subir o barramento só para perguntar
a11y_bus() {
    if [ -n "${PSITO_A11Y_BUS:-}" ]; then
        echo "$PSITO_A11Y_BUS"
        return
    fi
    command -v busctl >/dev/null || return 0
    local bus=(busctl --user --auto-start=no)
    [ "$("${bus[@]}" get-property org.a11y.Bus /org/a11y/bus org.a11y.Status IsEnabled 2>/dev/null)" = "b true" ] || return 0
    "${bus[@]}" call org.a11y.Bus /org/a11y/bus org.a11y.Bus GetAddress 2>/dev/null |
        sed -n 's/^s "\(.*\)"$/\1/p'
}
A11Y_BUS="$(a11y_bus)"
if [ -n "$A11Y_BUS" ]; then
    REGISTRY=org.a11y.atspi.Registry
    EVENTS=org.a11y.atspi.DeviceEventController
    EVENTS_PATH=/org/a11y/atspi/registry/deviceeventcontroller
    proxy+=("$A11Y_BUS" "$SOCKETS/a11y" --filter --sloppy-names
        "--call=$REGISTRY=org.a11y.atspi.Socket.Embed@/org/a11y/atspi/accessible/root"
        "--call=$REGISTRY=org.a11y.atspi.Socket.Unembed@/org/a11y/atspi/accessible/root"
        "--call=$REGISTRY=$REGISTRY.GetRegisteredEvents@/org/a11y/atspi/registry"
        "--call=$REGISTRY=$EVENTS.GetKeystrokeListeners@$EVENTS_PATH"
        "--call=$REGISTRY=$EVENTS.GetDeviceEventListeners@$EVENTS_PATH"
        "--call=$REGISTRY=$EVENTS.NotifyListenersSync@$EVENTS_PATH"
        "--call=$REGISTRY=$EVENTS.NotifyListenersAsync@$EVENTS_PATH")
fi

sandbox=(bwrap
    --unshare-all
    --die-with-parent --new-session --cap-drop ALL
    --ro-bind /usr /usr
    --symlink usr/bin /bin --symlink usr/sbin /sbin
    --symlink usr/lib /lib --symlink usr/lib64 /lib64
    --ro-bind /etc /etc
    --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig
    --proc /proc --dev /dev
    --dev-bind-try /dev/dri /dev/dri
    --ro-bind-try /sys/dev /sys/dev
    --ro-bind-try /sys/devices /sys/devices
    --ro-bind-try /sys/class /sys/class
    --ro-bind-try /sys/bus /sys/bus
    --tmpfs /tmp
    --dir "$RUN" --chmod 0700 "$RUN"
    --ro-bind "$RUN/$WAYLAND" "$RUN/$WAYLAND"
    --bind "$SOCKETS/bus" "$RUN/bus"
    --bind "$SOCKETS/system_bus" /run/dbus/system_bus_socket
    --symlink ../run /var/run
)
has network && sandbox+=(--share-net)
# A pasta inteira, que existe desde o boot: a de cada conta só nasce na primeira
# montagem, e um disco montado depois aparece aqui dentro do mesmo jeito. O
# UDisks2 protege a pasta de cada conta das outras
has files:removable && sandbox+=(--bind-try /media /media)
if [ -n "$A11Y_BUS" ]; then
    sandbox+=(--bind "$SOCKETS/a11y" "$RUN/at-spi/bus"
        --setenv AT_SPI_BUS_ADDRESS "unix:path=$RUN/at-spi/bus")
else
    sandbox+=(--setenv NO_AT_BRIDGE 1)
fi
if has files:home; then
    sandbox+=(--bind "$HOME" "$HOME")
else
    # As cores da ponte (o tema GTK) entram só para leitura
    sandbox+=(--bind "$DATA" "$HOME"
        --ro-bind-try "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-3.0")
fi
# Os ícones do usuário (o tema dos apps instalados no home), só para leitura
has files:home || sandbox+=(--ro-bind-try "$HOME/.local/share/icons" "$HOME/.local/share/icons")
sandbox+=("${DOCS[@]}")
sandbox+=(--chdir "$HOME"
    --unsetenv DISPLAY
    --unsetenv DBUS_SYSTEM_BUS_ADDRESS
    --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$RUN/bus"
    --setenv PSITO_APP_ID "$APP"
    -- "$@")

if [ "$DRY_RUN" = 1 ]; then
    echo "proxy:"; printf '%s\n' "${proxy[@]}"
    echo "bwrap:"; printf '%s\n' "${sandbox[@]}"
    exit 0
fi

for tool in bwrap xdg-dbus-proxy; do
    if ! command -v "$tool" >/dev/null; then
        # Sem o sandbox o app não abre: nunca cai para sem isolamento
        echo "psito-sandbox: falta o $tool; $APP não abre" >&2
        exit 127
    fi
done

# O que um sandbox morto com SIGKILL deixou: a pasta leva o pid no nome
for old in "$RUN"/psito-sandbox/*-*; do
    [ -d "$old" ] && ! kill -0 "${old##*-}" 2>/dev/null && rm -rf "$old"
done
mkdir -p -m 700 "$DATA" "$SOCKETS"
"${proxy[@]}" &
PROXY=$!
cleanup() {
    kill "$PROXY" 2>/dev/null || true
    rm -rf "$SOCKETS"
}
trap cleanup EXIT
# O systemctl stop do escopo manda TERM: sem isto o bash sai sem o trap EXIT
trap 'exit 143' TERM INT HUP
for _ in $(seq 100); do
    [ -S "$SOCKETS/bus" ] && [ -S "$SOCKETS/system_bus" ] &&
        { [ -z "$A11Y_BUS" ] || [ -S "$SOCKETS/a11y" ]; } && break
    kill -0 "$PROXY" 2>/dev/null || { echo "psito-sandbox: o proxy do D-Bus saiu" >&2; exit 1; }
    sleep 0.02
done

# Filho, e não exec: quando o app sai, o proxy sai junto (o trap)
set +e
"${sandbox[@]}"
status=$?
exit $status
