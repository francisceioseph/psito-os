<?xml version="1.0"?>
<!-- Configuração do labwc no spike. A seção <keyboard> é da ponte do shell. -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
  </core>
  <theme>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>sans</name><size>10</size><weight>bold</weight></font>
  </theme>
  <windowSwitcher show="yes" preview="yes" outlines="yes" />
  <snapping>
    <range>10</range>
    <topMaximize>yes</topMaximize>
  </snapping>
  <!-- Os atalhos são da ponte do shell (spike/shell_client/lib/bridge), que
       troca esta seção pela tabela do Psito e manda o labwc recarregar -->
  <keyboard>
    <default />
  </keyboard>
</labwc_config>
