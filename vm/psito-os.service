[Unit]
Description=Psito OS: sessão do labwc com o shell do Psito
After=systemd-user-sessions.service multi-user.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=psito
# Abre uma sessão do logind no tty1: o libseat recebe acesso à GPU e ao input sem root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
# No plano de cursor do virtio-gpu, o wlroots desenha o cursor de cabeça para baixo
Environment=WLR_NO_HARDWARE_CURSORS=1
# O autostart do labwc (~/.config/labwc) sobe o shell pela unidade psito-shell
ExecStart=/usr/bin/labwc
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
